# OS / editor
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# Secrets — never commit
.env
.env.*
*.pem
credentials.json
secrets/

# Child repo clones (keep repos/README.md only)
repos/*
!repos/README.md

# Dependencies inside clones
repos/*/node_modules/
repos/*/__pycache__/
repos/*/.venv/

# Build artifacts
dist/
build/
*.log

# LaTeX / arXiv build artifacts
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.out
*.synctex.gz
paper_templates/**/main.pdf
paper_templates/**/*_arXiv/
paper_templates/**/*_arXiv_submission.tar.gz

# Large archives (corpus artifacts live in ISA_2_0, not umbrella)
dodeca12*.zip
*.zip
