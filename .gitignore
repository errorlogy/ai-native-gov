# OS / editor
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# Secrets — never commit
.env
.env.*
*.pem
credentials.json
secrets/

# Child repo clones (keep repos/README.md only)
repos/*
!repos/README.md

# Dependencies inside clones
repos/*/node_modules/
repos/*/__pycache__/
repos/*/.venv/

# Build artifacts
dist/
build/
*.log

# Large archives (corpus artifacts live in ISA_2_0, not umbrella)
dodeca12*.zip
*.zip
